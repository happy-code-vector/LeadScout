// LeadScout data model — see spec.md "Data model (Prisma)".
//
// Storage note: SQLite has no enum, array, or json column types, so those
// fields are stored as text. src/lib/domain.ts is the single source of truth
// for allowed values (Zod-validated) and JSON encode/decode helpers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Category {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  textQuery    String
  // Must be a valid type from Google's Places API (New) place types table.
  // Null when the category has no exact Google type match.
  includedType String?
  // 0–10: how likely businesses in this category are to buy a website.
  propensity   Int        @default(5)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  businesses   Business[]

  @@index([active])
}

model Area {
  id        String   @id @default(cuid())
  name      String
  city      String
  state     String
  // Bounding box (south, west, north, east) used for Places tiling.
  south     Float
  west      Float
  north     Float
  east      Float
  parentId  String?
  parent    Area?    @relation("AreaTree", fields: [parentId], references: [id])
  children  Area[]   @relation("AreaTree")
  createdAt DateTime @default(now())

  @@index([city, state])
}

model DiscoveryRun {
  id           String   @id @default(cuid())
  // JSON string arrays: string[]
  categoryIds  String   @default("[]")
  areaIds      String   @default("[]")
  // RUNNING | COMPLETED | FAILED | CAP_REACHED
  status       String   @default("RUNNING")
  requestsUsed Int      @default(0)
  placesFound  Int      @default(0)
  newPlaces    Int      @default(0)
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  error        String?
}

model Business {
  id              String        @id @default(cuid())
  placeId         String        @unique
  name            String
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  address         String?
  borough         String?
  city            String?
  state           String?
  zip             String?
  lat             Float?
  lng             Float?
  phone           String?
  websiteUri      String?
  googleMapsUri   String?
  rating          Float?
  reviewCount     Int?
  businessStatus  String?
  primaryType     String?
  placesFetchedAt DateTime?
  isChain         Boolean       @default(false)
  createdAt       DateTime      @default(now())
  audit           WebsiteAudit?
  contacts        Contact[]
  score           Score?
  lead            Lead?
  inquiries       Inquiry[]

  @@index([categoryId])
  @@index([city, borough])
  @@index([isChain])
  @@index([placesFetchedAt])
}

model WebsiteAudit {
  id                String   @id @default(cuid())
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  checkedAt         DateTime @default(now())
  finalUrl          String?
  httpStatus        Int?
  // NONE | SOCIAL_OR_DIRECTORY | DEAD | PARKED | OUTDATED | OK
  websiteClass      String
  copyrightYear     Int?
  hasViewport       Boolean?
  httpsOk           Boolean?
  sitemapLastMod    DateTime?
  waybackLastChange DateTime?
  hasContactPath    Boolean?
  platform          String?
  // JSON string arrays: string[]
  findings          String   @default("[]")
  emailsFound       String   @default("[]")

  @@index([websiteClass])
}

model Contact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // EMAIL | PHONE | POSTAL
  type       String
  value      String
  // PLACES | WEBSITE | MANUAL
  source     String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([businessId, type, value])
  @@index([type, value])
}

model Score {
  id           String   @id @default(cuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  total        Int
  // A | B | C | D
  tier         String
  need         Int
  viability    Int
  reachability Int
  categoryFit  Int
  // JSON string array: string[]
  reasons      String   @default("[]")
  computedAt   DateTime @default(now())

  @@index([tier])
}

model Lead {
  id             String          @id @default(cuid())
  businessId     String          @unique
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // NEW | QUEUED | CONTACTED | REPLIED | MEETING | PROPOSAL | WON | LOST | DO_NOT_CONTACT
  status         String          @default("NEW")
  notes          String?
  lastActivityAt DateTime        @default(now())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         OutreachEvent[]
  callTasks      CallTask[]
  campaignLeads  CampaignLead[]

  @@index([status])
}

model Campaign {
  id           String          @id @default(cuid())
  name         String
  // MANUAL | AUTO
  mode         String
  // JSON string array of EMAIL | POSTAL | PHONE
  channelOrder String          @default("[\"EMAIL\", \"POSTAL\", \"PHONE\"]")
  // JSON object: { tier?: string[], categoryIds?: string[], areaNames?: string[], websiteClasses?: string[] }
  filters      String          @default("{}")
  sequenceId   String?
  sequence     Sequence?       @relation(fields: [sequenceId], references: [id])
  mailboxId    String?
  mailbox      Mailbox?        @relation(fields: [mailboxId], references: [id])
  dailyLimit   Int             @default(50)
  // JSON object: { startHour: number, endHour: number, daysOfWeek: number[] } — recipient-local hours.
  sendWindow   String          @default("{\"startHour\": 9, \"endHour\": 16, \"daysOfWeek\": [1, 2, 3, 4, 5]}")
  // DRAFT | RUNNING | PAUSED | STOPPED
  status       String          @default("DRAFT")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  events       OutreachEvent[]
  callTasks    CallTask[]
  campaignLeads CampaignLead[]

  @@index([status])
}

model Sequence {
  id        String          @id @default(cuid())
  name      String
  steps     SequenceStep[]
  campaigns Campaign[]
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  // EMAIL | POSTAL | PHONE
  channel    String
  delayDays  Int
  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  @@unique([sequenceId, order])
}

model Template {
  id        String          @id @default(cuid())
  name      String
  // EMAIL | POSTAL | PHONE
  channel   String
  subject   String?
  body      String
  variant   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  steps     SequenceStep[]
}

model Mailbox {
  id                String     @id @default(cuid())
  label             String
  smtpHost          String
  smtpPort          Int        @default(587)
  imapHost          String
  imapPort          Int        @default(993)
  user              String
  // AES-256-GCM encrypted with ENCRYPTION_KEY.
  passwordEncrypted String
  fromName          String?
  dailyLimit        Int        @default(40)
  warmupStartDate   DateTime?
  active            Boolean    @default(true)
  // Highest IMAP UID already processed (reply/bounce polling).
  imapLastUid       Int        @default(0)
  createdAt         DateTime   @default(now())
  campaigns         Campaign[]
}

// Explicitly added leads (Leads bulk action "add to campaign"), on top of
// the campaign's filter-matched pool.
model CampaignLead {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([campaignId, leadId])
}

model OutreachEvent {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // EMAIL | POSTAL | PHONE
  channel      String
  templateId   String?
  // SCHEDULED | SENT | BOUNCED | REPLIED | UNSUBSCRIBED | FAILED
  status       String
  messageId    String?
  scheduledFor DateTime?
  occurredAt   DateTime @default(now())
  // JSON object, free-form.
  meta         String?

  @@index([status, scheduledFor])
  @@index([campaignId, occurredAt])
  @@index([leadId, occurredAt])
}

model CallTask {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  dueAt       DateTime
  script      String?
  // NO_ANSWER | VOICEMAIL | INTERESTED | NOT_INTERESTED | CALL_BACK | DO_NOT_CALL
  outcome     String?
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([dueAt, completedAt])
}

model Suppression {
  id        String   @id @default(cuid())
  // An email address, phone number, or placeId — normalized.
  value     String   @unique
  reason    String
  createdAt DateTime @default(now())

  @@index([reason])
}

model Settings {
  id                      String   @id @default("singleton")
  senderName              String?
  senderPostalAddress     String?
  // JSON object; shape validated by src/lib/scoring/weights.ts.
  scoringWeights          String   @default("{}")
  placesMonthlyRequestCap Int      @default(1000)
  auditConcurrency        Int      @default(8)
  // JSON object; shape validated by src/lib/public/brand.ts.
  publicBrand             String?
  updatedAt               DateTime @updatedAt
}

model ApiUsage {
  id    String @id @default(cuid())
  // Calendar month, "YYYY-MM".
  month String
  sku   String
  count Int    @default(0)

  @@unique([month, sku])
}

// User was the Auth.js adapter model; password auth extends it in place.
// role/status are plain text validated by src/lib/domain.ts (SQLite: no enums).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER")
  status        String    @default("PENDING")
}

// Built-in background job queue, polled by the worker process.
model Job {
  id          String   @id @default(cuid())
  type        String
  // JSON object payload.
  payload     String   @default("{}")
  // PENDING | RUNNING | DONE | FAILED
  status      String   @default("PENDING")
  runAt       DateTime @default(now())
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAt])
}

// Inbound submissions from the public site (contact form + audit CTA).
model Inquiry {
  id            String       @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  businessType  String?
  website       String?
  message       String?
  // CONTACT_FORM | AUDIT_CTA
  source        String
  auditReportId String?
  auditReport   AuditReport? @relation(fields: [auditReportId], references: [id])
  businessId    String?
  business      Business?    @relation(fields: [businessId], references: [id])
  // NEW | CONTACTED | CONVERTED | DISMISSED
  status        String       @default("NEW")
  convertedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@index([status, createdAt])
}

// Public free-site-check report. Contains no LeadScout internals.
model AuditReport {
  id           String    @id @default(cuid())
  url          String
  finalUrl     String?
  // NONE | SOCIAL_OR_DIRECTORY | DEAD | PARKED | OUTDATED | OK
  websiteClass String
  findings     String    @default("[]")
  checkedAt    DateTime  @default(now())
  inquiries    Inquiry[]
}

// Published win stories for the public /results page.
model CaseStudy {
  id         String   @id @default(cuid())
  title      String
  summary    String
  // JSON array of { label: string, value: string }
  metrics    String   @default("[]")
  businessId String?
  siteUrl    String?
  published  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
